From 36a14edd37fe61ffb77bae37ab87126d4eaa998b Mon Sep 17 00:00:00 2001
From: Azixur Rahman <iremm12rr@gmail.com>
Date: Wed, 28 Oct 2026 14:15:29 +0530
Subject: [PATCH] fix: do not fail NT36525B probe when swrst DT property is
 missing

The stock CPH2185 DTBO does not contain novatek,swrst-n8-addr. AnyKernel only replaces the kernel, so the previous DTS change was never applied. Use the stock 0x03F0FE default and keep probing.
---
 .../touchscreen/mediatek/NT36525B/nt36xxx.c   | 32 ++++++++++++++++---
 1 file changed, 28 insertions(+), 4 deletions(-)

diff --git a/drivers/input/touchscreen/mediatek/NT36525B/nt36xxx.c b/drivers/input/touchscreen/mediatek/NT36525B/nt36xxx.c
index 393a3707bf1a..d18672a0e86d 100644
--- a/drivers/input/touchscreen/mediatek/NT36525B/nt36xxx.c
+++ b/drivers/input/touchscreen/mediatek/NT36525B/nt36xxx.c
@@ -124,7 +124,16 @@ static void nvt_ts_late_resume(struct early_suspend *h);
 #endif
 
 uint32_t ENG_RST_ADDR  = 0x7FFF80;
-uint32_t SWRST_N8_ADDR = 0; //read from dtsi
+/*
+ * NT36525B software-reset command address.
+ *
+ * The stock CPH2185 DTBO does not contain "novatek,swrst-n8-addr".
+ * An AnyKernel zip only replaces the kernel, not the DTBO, so relying on
+ * that property makes the driver abort before it can register the input
+ * device.  Use the value from the stock OPPO DTS as the default and let
+ * the DT override it when the property is present.
+ */
+uint32_t SWRST_N8_ADDR = 0x03F0FE;
 
 #if TOUCH_KEY_NUM > 0
 const uint16_t touch_key_array[TOUCH_KEY_NUM] = {
@@ -287,6 +296,14 @@ int32_t NVT_CTP_SPI_WRITE(struct spi_device *client, uint8_t *buf, uint16_t len)
 *******************************************************/
 void nvt_rest_ddi(void)
 {
+	/*
+	 * reset_global_gpio is optional and is not present in the stock
+	 * CPH2185 DTBO.  Do not call gpio_set_value() with an invalid GPIO.
+	 */
+	if (!gpio_is_valid(ts->reset_global_gpio)) {
+		NVT_LOG("%s : reset_global_gpio not available, skip", __func__);
+		return;
+	}
 	gpio_set_value(ts->reset_global_gpio, 0);
 	NVT_LOG("%s : Pull down reset_global_gpio",__func__);
 	mdelay(1);
@@ -1281,13 +1298,20 @@ static int32_t nvt_parse_dt(struct device *dev)
 
 	ret = of_property_read_u32(np, "novatek,swrst-n8-addr", &SWRST_N8_ADDR);
 	if (ret) {
-		NVT_ERR("error reading novatek,swrst-n8-addr. ret=%d\n", ret);
-		return ret;
+		/*
+		 * The stock CPH2185 DTBO has no swrst property.  Do not fail
+		 * probe: the driver can still identify the chip and use the
+		 * default NT36525B reset address.
+		 */
+		SWRST_N8_ADDR = 0x03F0FE;
+		NVT_LOG("novatek,swrst-n8-addr missing, using default 0x%06X\n",
+			SWRST_N8_ADDR);
+		ret = 0;
 	} else {
 		NVT_LOG("SWRST_N8_ADDR=0x%06X\n", SWRST_N8_ADDR);
 	}
 
-	return ret;
+	return 0;
 }
 #else
 static int32_t nvt_parse_dt(struct device *dev)
